                  "index.js",
                  "emotion.js",
                  "memory.js",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "pet",
                     "chat"
                 ],
